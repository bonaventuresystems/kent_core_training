<html>
<head>
    <title>Sign In</title>
</head>
<body>
<form method="post" action="/Login/SignIn">
        <h1>Sign In Here:</h1>
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" required />
        <br />
        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required />
        <br />
        <button type="submit">Sign In</button>
        <hr />
        <h3 style="color:red">
            @ViewBag.ErrorMessage
        </h3>
        <button onclick="SendUser()">Login </button>
</form>
<script>
    function SendUser() {
            debugger;
            var refTousername = document.getElementById("username");
            var refToPassword = document.getElementById("password");
            var user = { UserName: btoa(refTousername.value), Password: btoa(refToPassword.value) };
        
    }
</script>
</body>
</html>